{
  "env": {
    "N8N_EVENTS_URL": "SET_IN_LOCAL_SETTINGS_OR_SHELL_ENV",
    "SGM_WEBHOOK_TOKEN": "SET_IN_LOCAL_SETTINGS_OR_SHELL_ENV",
    "SGM_POD": "SET_IN_LOCAL_SETTINGS_OR_SHELL_ENV"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/report-event.sh file_changed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/report-event.sh session_stopped"
          }
        ]
      }
    ]
  }
}
